# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 절대 커밋하지 않는다.
# 이 파일(.env.example)은 Git에 올라가는 견본이므로 실제 키를 넣지 않는다.
# 유료 항목은 LLM(Amazon Bedrock) 하나뿐이다. 나머지 도구는 모두 무료이며 키가 필요 없다:
#   웹 검색 DuckDuckGo, 지도 OpenStreetMap(Nominatim, Overpass), 고도·날씨 Open-Meteo

# --- LLM (Amazon Bedrock) ---
# AWS 자격 증명은 아래 키 또는 AWS CLI 프로필(AWS_PROFILE) 중 하나로 설정한다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2
# AWS_PROFILE=default

# Bedrock 콘솔에서 접근 권한을 받은 Claude Sonnet 모델 ID (또는 추론 프로필 ID)
# 현재 사용: us.anthropic.claude-sonnet-4-5-20250929-v1:0 (us-west-2)
BEDROCK_MODEL_ID=
# 평가 루프의 LLM 판정기 모델 ID. 비워 두면 BEDROCK_MODEL_ID를 쓴다. Haiku 계열은 쓰지 않는다.
JUDGE_MODEL_ID=

# --- LangSmith 추적 (선택) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# --- 목업 전환 ---
# 웹 검색이 막혔을 때만 사용자 확인 후 true로 바꾼다. 항공권, 숙소는 항상 목업이다.
MOCK_SEARCH=false
